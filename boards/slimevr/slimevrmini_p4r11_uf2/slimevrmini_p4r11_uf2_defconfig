CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_MANUFACTURER="SlimeVR"
CONFIG_USB_DEVICE_PRODUCT="Butterfly P4R11"

CONFIG_BATTERY_USE_REG_BUCK_MAPPING=y
CONFIG_LED_RGB_COLOR=y
CONFIG_SENSOR_ROTATION_90=y

#generate for adafruit uf2 bootloader flashing
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_FLASH_LOAD_OFFSET=0x1000

# MAG on aux I2C yet not supported #77
CONFIG_SENSOR_USE_MAG=n

# Use XTAL FULL SWING clock source for TDMA
CONFIG_CLOCK_SOURCE_XTAL_FULL=y